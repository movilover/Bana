# BANA Backend Server Environment Variables (NEVER commit real .env values)
PORT=8788
NODE_ENV=development

# Allowed frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://bana-a5770.web.app"

# Firebase ID Token Verification
FIREBASE_PROJECT_ID="bana-a5770"
SUPER_ADMIN_EMAILS="omor.faruk.sojol.2@gmail.com"

# Optional WebRTC Coturn Self-Hosted TURN (HMAC-SHA1 REST credentials)
TURN_URLS=""
TURN_SHARED_SECRET=""

# Optional Open-Source LiveKit SFU Calling Server
LIVEKIT_WS_URL=""
LIVEKIT_HTTP_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Optional Paid Calling Providers (Require Admin Billing Approval before activation)
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""
HMS_ACCESS_KEY=""
HMS_APP_SECRET=""
HMS_TEMPLATE_ID=""

# Optional Supabase Backend Sync & Storage Presign
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_STORAGE_BUCKET="bana-media"

# Optional Media Broker Worker Proxy
MEDIA_BROKER_URL=""

# Optional Web Push VAPID (Open Standard)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@bana.app"

# SECURITY: comma-separated paid providers YOU approve (e.g. agora,100ms). Empty = every paid provider stays blocked.
# This is the ONLY place paid-provider billing approval is granted; client requests cannot override it.
APPROVED_PAID_PROVIDERS=""
