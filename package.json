{
  "name": "bana-web",
  "private": true,
  "version": "1.0.0-rc1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:verification": "node --experimental-strip-types --test tests/verification/paid-verification.logic.test.mjs tests/verification/friend-suggestions.logic.test.mjs tests/verification/video-distribution.logic.test.mjs tests/verification/video-rules-parity.test.mjs",
    "test:storage": "node tests/storage/multi-provider-e2e.test.mjs",
    "test:providers": "node --experimental-strip-types --test tests/providers/provider-validation.test.mjs",
    "test:backend": "npm --prefix backend install --no-audit --no-fund && npm --prefix backend run build && node tests/calling/backend-and-providers.test.mjs",
    "backup:verify": "node scripts/backup-manifest-cli.mjs",
    "check": "npm run lint && npm run build && npm run test:verification && npm run test:backend && npm run test:storage",
    "verify:export": "node scripts/verify-export.mjs",
    "test:ui": "node --experimental-strip-types --test tests/ui/upload-tracker-and-sound.test.mjs",
    "install:all": "npm ci && npm --prefix admin ci",
    "build:all": "node scripts/build-all.mjs",
    "lint:all": "npm run lint && npm --prefix admin run lint",
    "test:ui:dom": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
