# Copy to .dev.vars ONLY for local `wrangler dev` testing. NEVER commit .dev.vars!
FIREBASE_PROJECT_ID="bana-a5770"
ALLOWED_ORIGINS="http://localhost:3000"

# Cloudflare R2 (Primary)
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET="bana-media-primary"
R2_REGION="auto"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL=""

# Backblaze B2 (Secondary Backup)
B2_ENDPOINT="https://s3.<REGION>.backblazeb2.com"
B2_BUCKET="bana-media-backup"
B2_REGION="us-west-004"
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_PUBLIC_BASE_URL=""

# Optional Google Cloud Storage (Requires Billing Approval)
GCS_ENDPOINT="https://storage.googleapis.com"
GCS_BUCKET=""
GCS_REGION="auto"
GCS_ACCESS_KEY_ID=""
GCS_SECRET_ACCESS_KEY=""
GCS_PUBLIC_BASE_URL=""

# Optional Supabase Storage S3 (Free 50MB single-file limit)
SUPABASE_ENDPOINT="https://<PROJECT_REF>.supabase.co/storage/v1/s3"
SUPABASE_BUCKET="bana-media"
SUPABASE_REGION="us-east-1"
SUPABASE_ACCESS_KEY_ID=""
SUPABASE_SECRET_ACCESS_KEY=""
SUPABASE_PUBLIC_BASE_URL=""

# Optional Generic S3-Compatible (MinIO / Wasabi / DigitalOcean Spaces)
GENERIC_S3_ENDPOINT=""
GENERIC_S3_BUCKET=""
GENERIC_S3_REGION="us-east-1"
GENERIC_S3_ACCESS_KEY_ID=""
GENERIC_S3_SECRET_ACCESS_KEY=""
GENERIC_S3_PUBLIC_BASE_URL=""
