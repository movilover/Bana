# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web SDK Configuration (public client identifiers, copy from Firebase Console > Project settings).
# Leave EMPTY to use the bundled fallback; set real values only to point at a different project. src/firebase.ts falls back to the bundled bana-a5770 web config.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Optional: Firebase App Check reCAPTCHA v3 / Enterprise Site Key
VITE_FIREBASE_APPCHECK_SITE_KEY=""

# Optional: Firestore Named Database ID (leave empty for "(default)")
VITE_FIREBASE_DATABASE_ID=""

# Firebase Billing / Plan Architecture Mode
# Default is "spark" (Free Plan Only) with Cloud Functions disabled ("false").
# To upgrade to Blaze later, set VITE_FIREBASE_PLAN_MODE="blaze" and VITE_ENABLE_CLOUD_FUNCTIONS="true" after deploying functions/.
VITE_FIREBASE_PLAN_MODE="spark"
VITE_ENABLE_CLOUDFLARE_STREAM="false"
VITE_ENABLE_CLOUD_FUNCTIONS="false"

# Multi-Cloud Media Broker Worker URL (Cloudflare Workers Free Tier recommended)
# Handles SigV4 presigned PUT/GET URLs and cross-provider backup copies without Blaze Cloud Functions.
# Never put R2/B2/S3 secret keys in frontend VITE_* variables; configure them via `wrangler secret put`.
VITE_MEDIA_BROKER_URL=""

# Optional BANA Standalone Express + WebSocket Calling & Realtime Backend (Render Free / Local Port 8788)
# Leave empty on Firebase Spark Plan to use pure Firestore WebRTC signaling automatically.
VITE_BACKEND_URL=""
VITE_CALLING_PROVIDER="webrtc_builtin"

# ---------------------------------------------------------------------------
# Payments, payouts & advertising providers (Prompt 07/08)
# NONE of these are active by default and NO paid service is enabled without explicit admin approval.
# Secrets belong in Firebase Functions config / server environment ONLY — never in VITE_* variables.
# Without a provider, BANA records manual settlements: checkout = Cash on Delivery / manual mobile
# banking reference, creator payouts = admin-recorded transfer reference, ad billing = verified deposit.
# ---------------------------------------------------------------------------
# (Functions env) Checkout providers read by functions/src/index.ts — set only the ones you contract with:
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASS=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
NAGAD_MERCHANT_ID=""
NAGAD_PRIVATE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Creator payouts: NO automated payout provider is integrated. Payouts are reviewed by Finance and
# recorded as "manual_recorded" with a mandatory transfer reference. Nothing is ever marked paid
# automatically, so no payout credentials are needed or read by the code.

# URL of the separate BANA Admin Console site (optional; shows an "Admin Console" link to admins only)
VITE_ADMIN_URL=""
